local org = import './org.json';

// Local state for now (committed under git-crypt); see PLAN.md for the GCS TODO.
function(libs) {
  'tf/main.tf.json':
    std.manifestJsonEx(
      {
        '//': 'Generated by `make tf/main.tf.json`, please do not edit manually.',
        terraform: {
          required_providers: {
            github: {
              source: 'integrations/github',
              version: '~> 6.0',
            },
          },
          backend: {
            'local': { path: 'terraform.tfstate' },
          },
        },
        provider: {
          github: { owner: org.org },
        },
        resource: {
          github_repository: {
            [lib.name]: {
              name: lib.name + lib.suffix,
              description: lib.description,
              homepage_url: 'https://' + lib.repository,
              topics: ['jsonnet', 'jsonnet-lib'],
              auto_init: true,
              has_downloads: false,
              has_issues: true,
              has_projects: false,
              has_wiki: false,
              allow_merge_commit: false,
              allow_rebase_merge: false,
              delete_branch_on_merge: true,
            }
            for lib in libs
          },
        },
      },
      '  '
    ),
}
